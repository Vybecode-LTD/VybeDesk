<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             xmlns:ctl="using:ClaudePM.App.Controls"
             x:Class="ClaudePM.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <DockPanel LastChildFill="True">

        <ctl:ModuleHeader DockPanel.Dock="Top"/>

        <!-- Pagination — ALWAYS visible, docked to bottom. Buttons disable
             when there's only one page instead of hiding the bar entirely. -->
        <Border DockPanel.Dock="Bottom" Background="#22222A" Padding="0,6">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center">
                <Button Content="&#x2039; Previous"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"/>
                <TextBlock Text="{Binding PageLabel}"
                           VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
                <Button Content="Next &#x203A;"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </Border>

        <!-- Fill: 2-column card grid — no ScrollViewer, paginated to fit. -->
        <Grid Margin="16,10,16,6">

            <TextBlock Text="No projects yet &#x2014; open Projects in the sidebar to register or import one."
                       Opacity="0.5" TextWrapping="Wrap"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       IsVisible="{Binding !Cards.Count}"/>

            <ItemsControl ItemsSource="{Binding PagedCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectHealthCard">
                        <Button Classes="home-card" Padding="0"
                                Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenProjectCommand}"
                                CommandParameter="{Binding}"
                                Margin="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Stretch">
                            <Border Background="#2F2F38" CornerRadius="6" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <!-- Name row: logo + name + arrow -->
                                    <Grid ColumnDefinitions="30,*,Auto">
                                        <Border Grid.Column="0" Width="24" Height="24"
                                                CornerRadius="4" Background="#22222A"
                                                VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Panel>
                                                <Image Source="{Binding LogoBitmap}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasLogo}"/>
                                                <TextBlock Text="&#x1F4C1;" FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasLogo}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontWeight="Bold" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="&#x2192;" FontSize="12"
                                                   Opacity="0.4" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Description}" Opacity="0.6"
                                               FontSize="11" MaxLines="1"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding FolderPath}" Opacity="0.35"
                                               FontSize="10"
                                               FontFamily="Cascadia Code,Consolas,monospace"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Metrics row — compact icon+number badges with tooltips -->
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                        <Border Background="#3A2126" CornerRadius="8" Padding="6,2"
                                                ToolTip.Tip="Stale document findings">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="&#x1F4C4;" FontSize="10"/>
                                                <TextBlock Text="{Binding StaleDocLabel}" FontSize="10"
                                                           FontWeight="Bold" Foreground="#E06C6C"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1F2A3A" CornerRadius="8" Padding="6,2"
                                                ToolTip.Tip="Commits in the last 7 days">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="&#x2387;" FontSize="10"/>
                                                <TextBlock Text="{Binding RecentCommitLabel}" FontSize="10"
                                                           FontWeight="Bold" Foreground="#5E8FE0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#3A2F1F" CornerRadius="8" Padding="6,2"
                                                ToolTip.Tip="Pending agent actions">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="&#x26A1;" FontSize="10"/>
                                                <TextBlock Text="{Binding PendingActionLabel}" FontSize="10"
                                                           FontWeight="Bold" Foreground="#E0A95E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#2A2A33" CornerRadius="8" Padding="6,2"
                                                ToolTip.Tip="Last activity timestamp">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="&#x1F552;" FontSize="10"/>
                                                <TextBlock Text="{Binding LastActivityLabel}" FontSize="10"
                                                           Opacity="0.85"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="Loading metrics&#x2026;" Opacity="0.4" FontSize="10"
                                               IsVisible="{Binding IsLoading}"/>
                                    <TextBlock Text="(Metrics failed)" Opacity="0.5" FontSize="10"
                                               Foreground="#E06C6C"
                                               IsVisible="{Binding LoadFailed}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

    </DockPanel>

    <UserControl.Styles>
        <Style Selector="Button.home-card">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.home-card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
    </UserControl.Styles>
</UserControl>
