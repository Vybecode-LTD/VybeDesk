      "warn":       { "hex": "#DEB060", "oklch": "oklch(0.820 0.150 80)" },
      "warn-bg":    { "hex": "#473721", "oklch": "oklch(0.320 0.080 75)" },
      "danger":     { "hex": "#E97456", "oklch": "oklch(0.720 0.180 25)" },
      "danger-bg":  { "hex": "#4A2820", "oklch": "oklch(0.320 0.100 25)" },
      "info":       { "hex": "#7AA3D6", "oklch": "oklch(0.780 0.130 240)" },
      "info-bg":    { "hex": "#1F2D45", "oklch": "oklch(0.300 0.060 240)" }
    }
  },

  "type": {
    "family": {
      "sans": "Geist",
      "mono": "Geist Mono",
      "fallback-sans": "Segoe UI, system-ui, sans-serif",
      "fallback-mono": "Consolas, Cascadia Mono, monospace"
    },
    "scale-px": {
      "xs":  10.5,
      "sm":  11.5,
      "md":  13,
      "lg":  14.5,
      "xl":  17,
      "2xl": 22,
      "3xl": 32,
      "4xl": 52,
      "5xl": 88
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "line-height": {
      "body":    1.55,
      "ui":      1.4,
      "heading": 1.1,
      "display": 1.0
    },
    "letter-spacing-em": {
      "h1": -0.022, "h2": -0.018, "h3": -0.012, "h4": -0.008,
      "body": 0, "label": 0.06
    }
  },

  "spacing-px": {
    "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12,
    "6": 16, "7": 20, "8": 24, "9": 32, "10": 48, "11": 64, "12": 96
  },

  "radius-px": {
    "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 10, "6": 14, "full": 999
  },

  "elevation": {
    "xs":  "0 1px 1px rgba(20,15,5,.04)",
    "sm":  "0 1px 2px rgba(20,15,5,.06), 0 1px 1px rgba(20,15,5,.03)",
    "md":  "0 4px 14px rgba(20,15,5,.08), 0 1px 3px rgba(20,15,5,.04)",
    "lg":  "0 18px 40px rgba(20,15,5,.12), 0 4px 12px rgba(20,15,5,.06)",
    "focus": "0 0 0 3px rgba(217,122,48,.25)"
  },

  "motion": {
    "duration-ms": { "instant": 80, "quick": 140, "base": 200, "slow": 320 },
    "easing": {
      "out":    "cubic-bezier(0.2, 0.7, 0.2, 1.0)",
      "inout":  "cubic-bezier(0.6, 0.05, 0.2, 1.0)",
      "spring": "cubic-bezier(0.34, 1.36, 0.5, 1.0)"
    }
  },

  "density": {
    "compact":      { "control-height-px": 26, "control-pad-x-px": 9,  "row-pad-y-px": 6  },
    "cozy":         { "control-height-px": 30, "control-pad-x-px": 11, "row-pad-y-px": 8  },
    "comfortable":  { "control-height-px": 34, "control-pad-x-px": 13, "row-pad-y-px": 10 }
  },

  "default-density": "compact",
  "default-accent": "amber-38"
}
