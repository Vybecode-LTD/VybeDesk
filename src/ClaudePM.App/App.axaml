<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ClaudePM.App"
             xmlns:conv="using:ClaudePM.App.Converters"
             x:Class="ClaudePM.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <conv:SeverityToBrushConverter x:Key="SeverityBrush"/>
        <conv:DiffLineKindToBrushConverter x:Key="DiffLineBrush"/>
        <conv:BoolToToolActivityBrushConverter x:Key="ToolActivityBrush"/>
        <conv:AuditStatusToBrushConverter x:Key="AuditStatusBrush"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
    </Application.Resources>
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme/>

        <!--
          App-wide button polish: slightly rounded corners, tighter padding,
          12pt body font for compactness. Specific views can still override
          via their own Style selector (e.g. .chip in SkillManagerView).
          Goal: sleeker default look without breaking individual layouts.
        -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Styles>
</Application>
