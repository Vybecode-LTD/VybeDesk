<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             xmlns:ctl="using:ClaudePM.App.Controls"
             x:Class="ClaudePM.App.Views.DocumentationView"
             x:DataType="vm:DocumentationViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28,24,28,20">

        <!-- Controls -->
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="Documentation Manager" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Opacity="0.6"/>
            </StackPanel>

            <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="10">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject}"
                          PlaceholderText="Project…"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Project">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="1" Text="{Binding FolderPath}"
                         Watermark="Folder path to scan…"/>
                <Button Grid.Column="2" Content="Browse…"
                        Command="{Binding BrowseFolderCommand}"/>
                <Button Grid.Column="3" Content="Scan"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding IsNotBusy}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Run AI Analysis" Command="{Binding RunSemanticCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                <Button Content="Cancel"
                        Command="{Binding RunSemanticCancelCommand}"
                        IsVisible="{Binding IsBusy}"/>
                <Button Content="Audit Project" Command="{Binding RunAuditCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        ToolTip.Tip="Synthesize an audit across all docs: project design + roadmap items (complete / incomplete) + inconsistencies."/>
                <Button Content="Cancel"
                        Command="{Binding RunAuditCancelCommand}"
                        IsVisible="{Binding IsBusy}"/>
                <Button Content="Generate Fix Prompt" Command="{Binding GenerateFixPromptCommand}"/>
                <Button Content="Export Report" Command="{Binding ExportReportCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                <CheckBox Content="Watch mode"
                          IsChecked="{Binding IsWatchModeEnabled}"
                          ToolTip.Tip="Rescan automatically when .md / .txt files under the project folder change (debounced)."
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7"
                       TextWrapping="Wrap" Foreground="#9ABEE0"/>

            <!-- Summary chips -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasReport}">
                <Border Background="#E06C6C" CornerRadius="4" Padding="10,4">
                    <TextBlock Foreground="#1A1A1A" FontSize="12"
                               Text="{Binding CriticalCount, StringFormat='Critical {0}'}"/>
                </Border>
                <Border Background="#E0A95E" CornerRadius="4" Padding="10,4">
                    <TextBlock Foreground="#1A1A1A" FontSize="12"
                               Text="{Binding WarningCount, StringFormat='Warning {0}'}"/>
                </Border>
                <Border Background="#5E8FE0" CornerRadius="4" Padding="10,4">
                    <TextBlock Foreground="#1A1A1A" FontSize="12"
                               Text="{Binding InfoCount, StringFormat='Info {0}'}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="14" Margin="0,14,0,0">

            <!-- Documents -->
            <Border Grid.Column="0" Background="#22222A" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Documents" FontWeight="SemiBold"
                               Margin="2,0,0,8"/>
                    <ListBox ItemsSource="{Binding Docs}"
                             SelectedItem="{Binding SelectedDoc}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:DocFile">
                                <StackPanel Spacing="1" Margin="2,3">
                                    <TextBlock Text="{Binding RelativePath}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                               Opacity="0.4"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right column: findings (default) OR inline editor (when a doc
                 is selected). Mutually exclusive via IsEditorOpen. -->
            <Grid Grid.Column="1">

                <!-- Findings + panels (hidden while editor is open) -->
                <Grid IsVisible="{Binding IsDefaultViewVisible}"
                      RowDefinitions="*,Auto,Auto" RowSpacing="12">

                <Border Grid.Row="0" Background="#22222A" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Reconciliation findings"
                                   FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ListBox ItemsSource="{Binding Findings}" Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Finding">
                                    <Grid ColumnDefinitions="Auto,*" Margin="2,4" ColumnSpacing="10">
                                        <Border Grid.Column="0" CornerRadius="4" Padding="7,3"
                                                VerticalAlignment="Top"
                                                Background="{Binding Severity,
                                                    Converter={StaticResource SeverityBrush}}">
                                            <TextBlock Text="{Binding Severity}" FontSize="10"
                                                       Foreground="#1A1A1A"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Category}" FontSize="10"
                                                           Opacity="0.45"/>
                                                <TextBlock Text="{Binding File}" FontSize="10"
                                                           Opacity="0.45"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- AI semantic result -->
                <Border Grid.Row="1" Background="#2A2A33" CornerRadius="8" Padding="14"
                        MaxHeight="220" IsVisible="{Binding HasSemanticResult}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0" Text="AI semantic analysis"
                                       FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="Copy"
                                    Command="{Binding CopyCommand}"
                                    CommandParameter="{Binding SemanticResult}"
                                    Padding="8,2" FontSize="11"/>
                        </Grid>
                        <ScrollViewer>
                            <SelectableTextBlock Text="{Binding SemanticResult}"
                                                 TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Fix prompt -->
                <Border Grid.Row="2" Background="#2A2A33" CornerRadius="8" Padding="14"
                        IsVisible="{Binding IsFixPromptVisible}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Claude Code fix prompt"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Copy"
                                    Command="{Binding CopyCommand}"
                                    CommandParameter="{Binding FixPrompt}"
                                    Padding="8,2" FontSize="11"/>
                        </Grid>
                        <TextBox Text="{Binding FixPrompt}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="200"
                                 FontFamily="Cascadia Code,Consolas,monospace"/>
                    </StackPanel>
                </Border>

                </Grid>

                <!-- Project Audit overlay (M2.5) — synthesis pass output.
                     Replaces findings + editor when open. -->
                <DockPanel IsVisible="{Binding IsAuditOpen}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="Project Audit" FontWeight="SemiBold"
                                   FontSize="16" VerticalAlignment="Center"/>
                        <Button Content="Generate Fix Prompt"
                                Command="{Binding GenerateAuditFixPromptCommand}"
                                IsEnabled="{Binding HasInconsistencies}"
                                ToolTip.Tip="Build a Claude Code fix prompt covering the inconsistencies."/>
                        <Button Content="Close"
                                Command="{Binding CloseAuditCommand}"/>
                    </StackPanel>
                    <ScrollViewer>
                        <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

                            <!-- A) Project Design -->
                            <Border Background="#22222A" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="A) Project Design"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <ctl:MarkdownPresenter Markdown="{Binding AuditDesign}"/>
                                </StackPanel>
                            </Border>

                            <!-- B) Roadmap items (all) -->
                            <Border Background="#22222A" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="B) Roadmap — all items"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <ItemsControl ItemsSource="{Binding AuditItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditRoadmapItem">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      Margin="0,4" ColumnSpacing="10">
                                                    <Border Grid.Column="0" CornerRadius="3"
                                                            Padding="6,2" VerticalAlignment="Top"
                                                            Background="{Binding Status,
                                                                Converter={StaticResource AuditStatusBrush}}">
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="#1A1A1A" FontSize="10"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Evidence}"
                                                                   Opacity="0.6" FontSize="11"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="1"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10" Opacity="0.55"/>
                                                        <TextBlock Text="{Binding Source}"
                                                                   FontSize="10" Opacity="0.45"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- C) Completed -->
                            <Border Background="#22222A" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" FontSize="14">
                                        <Run Text="C) Completed ("/>
                                        <Run Text="{Binding AuditComplete.Count}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding AuditComplete}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditRoadmapItem">
                                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                                    <Run Text="✓ " Foreground="#7FD18B"/>
                                                    <Run Text="{Binding Title}"/>
                                                    <Run Text=" — " Foreground="#7F7F8A"/>
                                                    <Run Text="{Binding Evidence}" Foreground="#9B9BA0" FontSize="11"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- D) Incomplete -->
                            <Border Background="#22222A" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" FontSize="14">
                                        <Run Text="D) Incomplete / Unknown ("/>
                                        <Run Text="{Binding AuditIncomplete.Count}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding AuditIncomplete}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditRoadmapItem">
                                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                                    <Run Text="▢ " Foreground="#E0A95E"/>
                                                    <Run Text="{Binding Title}"/>
                                                    <Run Text=" — " Foreground="#7F7F8A"/>
                                                    <Run Text="{Binding Source}" Foreground="#9B9BA0" FontSize="11"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Audit fix prompt — appears after Generate Fix
                                 Prompt is clicked. -->
                            <Border Background="#2A2A33" CornerRadius="8" Padding="14"
                                    IsVisible="{Binding IsAuditFixPromptVisible}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Claude Code fix prompt"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Copy"
                                                Command="{Binding CopyCommand}"
                                                CommandParameter="{Binding AuditFixPrompt}"
                                                Padding="8,2" FontSize="11"/>
                                    </Grid>
                                    <TextBox Text="{Binding AuditFixPrompt}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="320"
                                             FontFamily="Cascadia Code,Consolas,monospace"
                                             FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Inconsistencies -->
                            <Border Background="#2A2A33" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" FontSize="14">
                                        <Run Text="Inconsistencies ("/>
                                        <Run Text="{Binding AuditInconsistencies.Count}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <TextBlock Text="No disagreements found across the docs."
                                               Opacity="0.55"
                                               IsVisible="{Binding !HasInconsistencies}"/>
                                    <ItemsControl ItemsSource="{Binding AuditInconsistencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditInconsistency">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      Margin="0,4" ColumnSpacing="10">
                                                    <Border Grid.Column="0" CornerRadius="3"
                                                            Padding="6,2" VerticalAlignment="Top"
                                                            Background="{Binding Severity,
                                                                Converter={StaticResource SeverityBrush}}">
                                                        <TextBlock Text="{Binding Severity}"
                                                                   Foreground="#1A1A1A" FontSize="10"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Issue}"
                                                                   TextWrapping="Wrap"/>
                                                        <ItemsControl ItemsSource="{Binding Docs}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Background="#33333E"
                                                                            CornerRadius="3"
                                                                            Padding="5,1" Margin="0,0,4,0">
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="10"
                                                                                   FontFamily="Cascadia Code,Consolas,monospace"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Inline doc editor (M2.6) — replaces findings when a doc
                     is selected. Header docks top, body fills, buttons row
                     pinned visually via the header. -->
                <DockPanel IsVisible="{Binding IsEditorOpen}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Spacing="8" Margin="0,0,0,10">
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380"/>
                        <Button Content="Save"
                                Command="{Binding SaveEditorCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Revert"
                                Command="{Binding RevertEditorCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Close"
                                Command="{Binding CloseEditorCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding EditorContent}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             AcceptsTab="True"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="13"
                             VerticalContentAlignment="Top"/>
                </DockPanel>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
