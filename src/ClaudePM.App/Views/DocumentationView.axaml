<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             x:Class="ClaudePM.App.Views.DocumentationView"
             x:DataType="vm:DocumentationViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28,24,28,20">

        <!-- Controls -->
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="Documentation Manager" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Opacity="0.6"/>
            </StackPanel>

            <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="10">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject}"
                          PlaceholderText="Project…"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Project">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="1" Text="{Binding FolderPath}"
                         Watermark="Folder path to scan…"/>
                <Button Grid.Column="2" Content="Browse…"
                        Command="{Binding BrowseFolderCommand}"/>
                <Button Grid.Column="3" Content="Scan"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding IsNotBusy}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Run AI Analysis" Command="{Binding RunSemanticCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                <Button Content="Cancel"
                        Command="{Binding RunSemanticCancelCommand}"
                        IsVisible="{Binding IsBusy}"/>
                <Button Content="Generate Fix Prompt" Command="{Binding GenerateFixPromptCommand}"/>
                <Button Content="Export Report" Command="{Binding ExportReportCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                <CheckBox Content="Watch mode"
                          IsChecked="{Binding IsWatchModeEnabled}"
                          ToolTip.Tip="Rescan automatically when .md / .txt files under the project folder change (debounced)."
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7"
                       TextWrapping="Wrap" Foreground="#9ABEE0"/>

            <!-- Summary chips -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasReport}">
                <Border Background="#E06C6C" CornerRadius="4" Padding="10,4">
                    <TextBlock Foreground="#1A1A1A" FontSize="12"
                               Text="{Binding CriticalCount, StringFormat='Critical {0}'}"/>
                </Border>
                <Border Background="#E0A95E" CornerRadius="4" Padding="10,4">
                    <TextBlock Foreground="#1A1A1A" FontSize="12"
                               Text="{Binding WarningCount, StringFormat='Warning {0}'}"/>
                </Border>
                <Border Background="#5E8FE0" CornerRadius="4" Padding="10,4">
                    <TextBlock Foreground="#1A1A1A" FontSize="12"
                               Text="{Binding InfoCount, StringFormat='Info {0}'}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="14" Margin="0,14,0,0">

            <!-- Documents -->
            <Border Grid.Column="0" Background="#22222A" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Documents" FontWeight="SemiBold"
                               Margin="2,0,0,8"/>
                    <ListBox ItemsSource="{Binding Docs}"
                             SelectedItem="{Binding SelectedDoc}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:DocFile">
                                <StackPanel Spacing="1" Margin="2,3">
                                    <TextBlock Text="{Binding RelativePath}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                               Opacity="0.4"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right column: findings (default) OR inline editor (when a doc
                 is selected). Mutually exclusive via IsEditorOpen. -->
            <Grid Grid.Column="1">

                <!-- Findings + panels (hidden while editor is open) -->
                <Grid IsVisible="{Binding IsDefaultViewVisible}"
                      RowDefinitions="*,Auto,Auto" RowSpacing="12">

                <Border Grid.Row="0" Background="#22222A" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Reconciliation findings"
                                   FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ListBox ItemsSource="{Binding Findings}" Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Finding">
                                    <Grid ColumnDefinitions="Auto,*" Margin="2,4" ColumnSpacing="10">
                                        <Border Grid.Column="0" CornerRadius="4" Padding="7,3"
                                                VerticalAlignment="Top"
                                                Background="{Binding Severity,
                                                    Converter={StaticResource SeverityBrush}}">
                                            <TextBlock Text="{Binding Severity}" FontSize="10"
                                                       Foreground="#1A1A1A"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Category}" FontSize="10"
                                                           Opacity="0.45"/>
                                                <TextBlock Text="{Binding File}" FontSize="10"
                                                           Opacity="0.45"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- AI semantic result -->
                <Border Grid.Row="1" Background="#2A2A33" CornerRadius="8" Padding="14"
                        MaxHeight="220" IsVisible="{Binding HasSemanticResult}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="AI semantic analysis"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer>
                            <SelectableTextBlock Text="{Binding SemanticResult}"
                                                 TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Fix prompt -->
                <Border Grid.Row="2" Background="#2A2A33" CornerRadius="8" Padding="14"
                        IsVisible="{Binding IsFixPromptVisible}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Claude Code fix prompt — select and copy"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FixPrompt}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="200"
                                 FontFamily="Cascadia Code,Consolas,monospace"/>
                    </StackPanel>
                </Border>

                </Grid>

                <!-- Inline doc editor (M2.6) — replaces findings when a doc
                     is selected. Header docks top, body fills, buttons row
                     pinned visually via the header. -->
                <DockPanel IsVisible="{Binding IsEditorOpen}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Spacing="8" Margin="0,0,0,10">
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380"/>
                        <Button Content="Save"
                                Command="{Binding SaveEditorCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Revert"
                                Command="{Binding RevertEditorCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Close"
                                Command="{Binding CloseEditorCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding EditorContent}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             AcceptsTab="True"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="13"
                             VerticalContentAlignment="Top"/>
                </DockPanel>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
