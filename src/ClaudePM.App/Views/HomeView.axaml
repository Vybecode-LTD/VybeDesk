<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             x:Class="ClaudePM.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Home" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Opacity="0.6"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:Project">
                        <Border Background="#2F2F38" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FolderPath}" Opacity="0.4" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
