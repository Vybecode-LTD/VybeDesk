<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             xmlns:ctl="using:ClaudePM.App.Controls"
             x:Class="ClaudePM.App.Views.NotebookView"
             x:DataType="vm:NotebookViewModel">

    <Grid ColumnDefinitions="*,366">

        <!-- Chat -->
        <DockPanel Grid.Column="0" Margin="24,20,12,20">
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="AI Notebook" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#9ABEE0"
                           Opacity="0.85" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8" Margin="0,10,0,0">
                <TextBox Grid.Column="0" Text="{Binding ChatInput}"
                         Watermark="Ask for advice, or ask to create / move files… (Ctrl+Enter to send)"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Send" VerticalAlignment="Stretch"
                        Command="{Binding SendCommand}" IsEnabled="{Binding IsNotBusy}"/>
                <Button Grid.Column="2" Content="Cancel" VerticalAlignment="Stretch"
                        Command="{Binding SendCancelCommand}"
                        IsVisible="{Binding IsBusy}"/>
            </Grid>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotebookMessage">
                            <Border Background="#2A2A33" CornerRadius="8" Padding="12"
                                    Margin="0,0,0,8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Role}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" Opacity="0.55"/>
                                        <Button Grid.Column="1" Content="Copy"
                                                IsVisible="{Binding HasText}"
                                                Padding="6,1" FontSize="10"
                                                Command="{Binding $parent[ItemsControl].((vm:NotebookViewModel)DataContext).CopyMessageCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <!-- Tool actions ABOVE the prose: italic chips,
                                         green for success, red for blocked / failure. -->
                                    <ItemsControl ItemsSource="{Binding Activities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ToolActivity">
                                                <TextBlock Text="{Binding Description}"
                                                           FontStyle="Italic"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding Success,
                                                               Converter={StaticResource ToolActivityBrush}}"
                                                           Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- "Thinking…" skeleton — shown for an
                                         assistant bubble until the first
                                         text delta lands. -->
                                    <TextBlock Text="thinking…"
                                               FontStyle="Italic"
                                               Foreground="#7F7F8A"
                                               IsVisible="{Binding ShowThinkingPlaceholder}"/>

                                    <!-- Markdown prose via our custom
                                         Markdig-backed presenter (M2.8).
                                         Headings, fenced code blocks,
                                         tables, inline code, bold/italic,
                                         lists, blockquotes. -->
                                    <ctl:MarkdownPresenter Markdown="{Binding Text}"
                                                           IsVisible="{Binding HasText}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Side panel -->
        <Border Grid.Column="1" Background="#22222A">
            <ScrollViewer Padding="16">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="6">
                        <TextBlock Text="Active project" FontWeight="SemiBold"/>
                        <TextBlock Text="File actions are confined to this project's folder."
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        <ComboBox ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding ActiveProject}"
                                  PlaceholderText="No projects registered"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Project">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <SelectableTextBlock Text="{Binding ScopedRootsText}" FontSize="11"
                                             Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Proposed actions" FontWeight="SemiBold"/>
                        <TextBlock Text="Claude's file actions appear here for review before they run."
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding PendingActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AgentActionRow">
                                    <Border Background="#2A2A33" CornerRadius="6"
                                            Padding="10" Margin="0,3">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                       Opacity="0.6" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding HasPendingActions}">
                            <Button Content="Execute All" Command="{Binding ExecuteActionsCommand}"
                                    IsEnabled="{Binding IsNotBusy}"/>
                            <Button Content="Cancel"
                                    Command="{Binding ExecuteActionsCancelCommand}"
                                    IsVisible="{Binding IsBusy}"/>
                            <Button Content="Clear" Command="{Binding ClearActionsCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Action history" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ActionHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontSize="11" Opacity="0.6"
                                               TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Undo Last" Command="{Binding UndoLastCommand}"
                                IsEnabled="{Binding CanUndo}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <Button Content="Save last response as note"
                                Command="{Binding SaveLastResponseCommand}"/>
                        <ListBox ItemsSource="{Binding Notes}"
                                 SelectedItem="{Binding SelectedNote}"
                                 Background="Transparent" BorderThickness="0" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Note">
                                    <TextBlock Text="{Binding Title}" Margin="2,3"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected-note actions + body preview -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding SelectedNote,
                                        Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Insert into chat"
                                        Command="{Binding InsertNoteIntoChatCommand}"
                                        Padding="8,2" FontSize="11"
                                        ToolTip.Tip="Prepend this note's text to the chat input as reference for your next message."/>
                                <Button Content="Copy"
                                        Command="{Binding CopySelectedNoteCommand}"
                                        Padding="8,2" FontSize="11"/>
                                <Button Content="Delete"
                                        Command="{Binding DeleteNoteCommand}"
                                        Padding="8,2" FontSize="11"/>
                            </StackPanel>
                            <Border Background="#1B1B22" CornerRadius="6" Padding="10" MaxHeight="200">
                                <ScrollViewer>
                                    <SelectableTextBlock Text="{Binding SelectedNote.Body}"
                                                         FontSize="11"
                                                         TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
