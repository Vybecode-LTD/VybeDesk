<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             x:Class="ClaudePM.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

    <Grid ColumnDefinitions="340,*">

        <!-- LEFT: project list -->
        <Border Grid.Column="0" Background="#22222A" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <TextBlock Text="Projects" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" Opacity="0.55" FontSize="11"
                               TextWrapping="Wrap"/>
                    <Button Content="New project" Command="{Binding NewProjectCommand}"
                            IsEnabled="{Binding IsNotBusy}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <ListBox Margin="0,12,0,0"
                         ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Project">
                            <StackPanel Spacing="2" Margin="2,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FolderPath}" FontSize="10"
                                           Opacity="0.45"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT: editor -->
        <ScrollViewer Grid.Column="1" Padding="28">
            <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock Text="{Binding StatusMessage}" Opacity="0.7"
                           TextWrapping="Wrap" Foreground="#9ABEE0"/>

                <TextBlock Text="Select a project on the left or create a new one."
                           Opacity="0.5"
                           IsVisible="{Binding !HasSelection}"/>

                <StackPanel Spacing="12" IsVisible="{Binding HasSelection}">
                    <TextBlock Text="Edit project" FontSize="18" FontWeight="SemiBold"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Name" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding EditName}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Description" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding EditDescription}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Folder path — used as the scope root for AI actions and doc scans"
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding EditFolderPath}"
                                     Watermark="C:\dev\my-project"/>
                            <Button Grid.Column="1" Content="Browse…"
                                    Command="{Binding BrowseFolderCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Status" Opacity="0.6" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding EditStatus}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
