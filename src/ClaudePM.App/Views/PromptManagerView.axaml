<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             x:Class="ClaudePM.App.Views.PromptManagerView"
             x:DataType="vm:PromptManagerViewModel">

    <Grid ColumnDefinitions="340,*">

        <!-- LEFT: prompt list -->
        <Border Grid.Column="0" Background="#22222A" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <TextBlock Text="Prompts" FontSize="20" FontWeight="SemiBold"/>
                    <TextBox Watermark="Search title, body, tags…"
                             Text="{Binding SearchText}"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              HorizontalAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="New" Command="{Binding NewPromptCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Generate with AI"
                                Command="{Binding ToggleGeneratePanelCommand}"/>
                    </StackPanel>
                </StackPanel>
                <ListBox Margin="0,12,0,0"
                         ItemsSource="{Binding Prompts}"
                         SelectedItem="{Binding SelectedPrompt}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:PromptEntry">
                            <StackPanel Spacing="2" Margin="2,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.5"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT: detail / editor -->
        <ScrollViewer Grid.Column="1" Padding="28">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

                <TextBlock Text="{Binding StatusMessage}" Opacity="0.7"
                           TextWrapping="Wrap" Foreground="#9ABEE0"/>

                <!-- AI Generate panel -->
                <Border Background="#2A2A33" CornerRadius="8" Padding="18"
                        IsVisible="{Binding IsGeneratePanelOpen}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Generate a prompt with AI" FontWeight="SemiBold"/>
                        <TextBlock Text="Describe what you need a prompt for."
                                   Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding GenerateRequest}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                        <Button Content="Generate" Command="{Binding GenerateCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <TextBox Text="{Binding GeneratedPrompt}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                 Watermark="The generated prompt appears here…"/>
                        <Button Content="Save as new prompt"
                                Command="{Binding SaveGeneratedCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Empty-state placeholder -->
                <TextBlock Text="Select a prompt from the list, or create a new one."
                           Opacity="0.5"
                           IsVisible="{Binding !HasSelection}"/>

                <!-- Editor -->
                <StackPanel Spacing="12" IsVisible="{Binding HasSelection}">
                    <TextBlock Text="Edit prompt" FontSize="18" FontWeight="SemiBold"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Title" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding EditTitle}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Category" Opacity="0.6" FontSize="12"/>
                            <TextBox Text="{Binding EditCategory}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Tags (comma-separated)" Opacity="0.6" FontSize="12"/>
                            <TextBox Text="{Binding EditTagsText}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Body — use {{variable}} for placeholders"
                                   Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding EditBody}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="180" FontFamily="Cascadia Code,Consolas,monospace"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Fill Template" Command="{Binding OpenFillPanelCommand}"/>
                        <Button Content="AI Redesign" Command="{Binding RedesignCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Template fill panel -->
                <Border Background="#2A2A33" CornerRadius="8" Padding="18"
                        IsVisible="{Binding IsFillPanelOpen}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Fill template" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Variables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TemplateVariable">
                                    <Grid ColumnDefinitions="160,*" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Build" Command="{Binding BuildFilledCommand}"/>
                        <TextBox Text="{Binding FilledResult}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                 Watermark="The filled prompt appears here — select and copy."/>
                    </StackPanel>
                </Border>

                <!-- AI redesign panel -->
                <Border Background="#2A2A33" CornerRadius="8" Padding="18"
                        IsVisible="{Binding IsRedesignPanelOpen}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="AI redesign" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RedesignResult}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply to body" Command="{Binding ApplyRedesignCommand}"/>
                            <Button Content="Dismiss" Command="{Binding DismissRedesignCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
