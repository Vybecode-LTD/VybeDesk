<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             x:Class="ClaudePM.App.Views.SessionBuilderView"
             x:DataType="vm:SessionBuilderViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="28,24,28,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="Session Builder" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StepLabel}" Foreground="#9ABEE0"/>
        </StackPanel>

        <!-- Step content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                <!-- Step 1: Describe -->
                <StackPanel Spacing="12" IsVisible="{Binding IsDescribe}">
                    <TextBlock Text="Describe the project" FontSize="17" FontWeight="SemiBold"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Project name" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding ProjectName}"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Description" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding ProjectDescription}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Stack (optional)" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding Stack}" Watermark="e.g. Avalonia / .NET 9"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Output location — where the package folder is created"
                                   Opacity="0.6" FontSize="12"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding OutputLocation}"
                                     Watermark="C:\dev\…"/>
                            <Button Grid.Column="1" Content="Browse…"
                                    Command="{Binding BrowseOutputLocationCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: Transcripts -->
                <StackPanel Spacing="12" IsVisible="{Binding IsTranscripts}">
                    <TextBlock Text="Add conversation transcripts" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Paste each claude.ai conversation that shaped this project."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding NewTranscriptTitle}" Watermark="Transcript title (optional)"/>
                    <TextBox Text="{Binding NewTranscriptBody}" Watermark="Paste transcript text…"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"/>
                    <Button Content="Add transcript" Command="{Binding AddTranscriptCommand}"/>
                    <ListBox ItemsSource="{Binding Transcripts}"
                             SelectedItem="{Binding SelectedTranscript}"
                             Background="#22222A" BorderThickness="0" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:TranscriptEntry">
                                <TextBlock Text="{Binding DisplayTitle}" Margin="2,3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Remove selected" Command="{Binding RemoveTranscriptCommand}"/>
                </StackPanel>

                <!-- Step 3: Files -->
                <StackPanel Spacing="12" IsVisible="{Binding IsFiles}">
                    <TextBlock Text="Stage files" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Add files to bring into the handoff package. Enter a full path."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding NewFilePath}"
                                 Watermark="C:\path\to\file.ext"/>
                        <Button Grid.Column="1" Content="Browse…"
                                Command="{Binding BrowseNewFileCommand}"/>
                        <Button Grid.Column="2" Content="Add" Command="{Binding AddFileCommand}"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding FilePaths}"
                             SelectedItem="{Binding SelectedFilePath}"
                             Background="#22222A" BorderThickness="0" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" Margin="2,3"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Remove selected" Command="{Binding RemoveFileCommand}"/>
                </StackPanel>

                <!-- Step 4: Review -->
                <StackPanel Spacing="12" IsVisible="{Binding IsReview}">
                    <TextBlock Text="AI review (optional)" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Have Claude flag anything likely missing for a clean handoff."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    <Button Content="Run AI Review" Command="{Binding RunReviewCommand}"
                            IsEnabled="{Binding IsNotBusy}" HorizontalAlignment="Left"/>
                    <Border Background="#2A2A33" CornerRadius="8" Padding="14"
                            IsVisible="{Binding ReviewResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <SelectableTextBlock Text="{Binding ReviewResult}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Step 5: Generate -->
                <StackPanel Spacing="12" IsVisible="{Binding IsGenerate}">
                    <TextBlock Text="Generate the handoff package" FontSize="17" FontWeight="SemiBold"/>
                    <Border Background="#22222A" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ProjectName, StringFormat='Project: {0}'}"/>
                            <TextBlock Text="{Binding Transcripts.Count, StringFormat='Transcripts: {0}'}"
                                       Opacity="0.7"/>
                            <TextBlock Text="{Binding FilePaths.Count, StringFormat='Staged files: {0}'}"
                                       Opacity="0.7"/>
                            <TextBlock Text="{Binding OutputLocation, StringFormat='Output: {0}'}"
                                       Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Creates a folder with CLAUDE.md, README.md, .gitignore, KICKOFF.md, your transcripts, and staged files. Claude Code builds the code from there."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    <Button Content="Generate Handoff Package" Command="{Binding GenerateCommand}"
                            IsEnabled="{Binding IsNotBusy}" HorizontalAlignment="Left"/>
                    <SelectableTextBlock Text="{Binding ResultMessage}" Foreground="#7FD18B"
                                         TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#9ABEE0"
                       Opacity="0.85" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Back" Command="{Binding BackCommand}"
                        IsVisible="{Binding ShowBack}"/>
                <Button Content="Next" Command="{Binding NextCommand}"
                        IsVisible="{Binding ShowNext}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
