<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudePM.App.ViewModels"
             xmlns:m="using:ClaudePM.Core.Models"
             x:Class="ClaudePM.App.Views.SkillLibraryView"
             x:DataType="vm:SkillLibraryViewModel">

    <!--
      Skill Library view — rebuilt from scratch around the "scrollable page
      with a fixed-height inner list" pattern. The right pane is one
      ScrollViewer over a vertical StackPanel of sections. Each section
      either sizes to its content (text, fields, buttons) OR has an
      explicit fixed Height (the Resources ListBox) so its internal
      ScrollViewer can take over for overflow. No nested MaxHeight games,
      no ClipToBounds workarounds — the canonical Avalonia pattern is:

        <Border Height="X">
            <ListBox
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Visible">

      Border.Height is concrete (not MaxHeight), so the bound is enforced
      at layout time with no ambiguity. The ListBox fills that exact
      rectangle and its built-in ScrollViewer handles all the scrolling.
    -->

    <Grid ColumnDefinitions="320,*">

        <!-- ─── LEFT: scan controls + skill list ─────────────────── -->
        <Border Grid.Column="0" Background="#22222A" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <TextBlock Text="Skill Library" FontSize="20" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding FolderPath}" Watermark="Folder with .skill files…"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Browse…" Command="{Binding BrowseFolderCommand}"/>
                        <Button Content="Scan" Command="{Binding ScanCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                    </StackPanel>
                </StackPanel>
                <ListBox Margin="0,12,0,0"
                         ItemsSource="{Binding Skills}"
                         SelectedItem="{Binding SelectedSkill}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:SkillFile">
                            <StackPanel Spacing="2" Margin="2,4">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FileName}" FontSize="10" Opacity="0.4"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ─── RIGHT: details + editor (single scrolling page) ──── -->
        <ScrollViewer Grid.Column="1" Padding="28">
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

                <!-- Status line -->
                <TextBlock Text="{Binding StatusMessage}" Opacity="0.7"
                           TextWrapping="Wrap" Foreground="#9ABEE0"/>

                <!-- Severity chips: click to filter Issues to that severity
                     across every scanned skill. Clear Filter resets. -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding HasResults}">
                    <Button Background="#E06C6C" CornerRadius="4" Padding="10,4"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding FilterBySeverityCommand}"
                            CommandParameter="{x:Static m:FindingSeverity.Critical}">
                        <TextBlock Foreground="#1A1A1A" FontSize="12"
                                   Text="{Binding CriticalCount, StringFormat='Critical {0}'}"/>
                    </Button>
                    <Button Background="#E0A95E" CornerRadius="4" Padding="10,4"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding FilterBySeverityCommand}"
                            CommandParameter="{x:Static m:FindingSeverity.Warning}">
                        <TextBlock Foreground="#1A1A1A" FontSize="12"
                                   Text="{Binding WarningCount, StringFormat='Warning {0}'}"/>
                    </Button>
                    <Button Background="#5E8FE0" CornerRadius="4" Padding="10,4"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding FilterBySeverityCommand}"
                            CommandParameter="{x:Static m:FindingSeverity.Info}">
                        <TextBlock Foreground="#1A1A1A" FontSize="12"
                                   Text="{Binding InfoCount, StringFormat='Info {0}'}"/>
                    </Button>
                    <Button Content="Clear Filter"
                            Command="{Binding ClearFilterCommand}"
                            IsVisible="{Binding IsFilterActive}"
                            Padding="10,4" FontSize="12"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Filter-active view: every finding of the chosen severity
                     across all skills, each with a 📋 Copy button. -->
                <StackPanel Spacing="6" IsVisible="{Binding IsFilterActive}">
                    <TextBlock Text="{Binding FilterHeader}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:Finding">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" ColumnSpacing="10">
                                    <Border Grid.Column="0" CornerRadius="4" Padding="7,3"
                                            VerticalAlignment="Top"
                                            Background="{Binding Severity,
                                                Converter={StaticResource SeverityBrush}}">
                                        <TextBlock Text="{Binding Severity}" FontSize="10"
                                                   Foreground="#1A1A1A"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding File}"
                                                       FontWeight="SemiBold" FontSize="10"
                                                       Opacity="0.65"/>
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Opacity="0.45"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="📋"
                                            VerticalAlignment="Top"
                                            Padding="6,2" FontSize="12"
                                            ToolTip.Tip="Copy as one line for Claude Code"
                                            Command="{Binding $parent[ItemsControl].((vm:SkillLibraryViewModel)DataContext).CopyFindingCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Empty-state hint when nothing is selected and no filter is active. -->
                <TextBlock Text="Select a skill to edit and validate it."
                           Opacity="0.5"
                           IsVisible="{Binding !HasSelection}"/>

                <!-- ─── Editor (visible when a skill is selected, no filter) ─── -->
                <StackPanel Spacing="14" IsVisible="{Binding IsEditorVisible}">

                    <TextBlock Text="Edit skill" FontSize="18" FontWeight="SemiBold"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Name" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding EditName}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Description" Opacity="0.6" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding DescriptionBudget}"
                                       FontSize="12" Opacity="0.6"/>
                        </Grid>
                        <TextBox Text="{Binding EditDescription}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Body" Opacity="0.6" FontSize="12"/>
                        <TextBox Text="{Binding EditBody}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200"
                                 FontFamily="Cascadia Code,Consolas,monospace"/>
                    </StackPanel>

                    <!-- Action row -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Rename" Command="{Binding RenameCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                ToolTip.Tip="Rename the file (or folder, for SKILL.md format) to match the Name field above."/>
                        <Button Content="Export" Command="{Binding ExportCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                ToolTip.Tip="Write both *.skill (Claude web) AND folder/SKILL.md (Claude Code) into the Folder path above."/>
                    </StackPanel>

                    <!-- ─── Resources section ───
                         Fixed-height Border wrapping a ListBox. The Border
                         is ALWAYS exactly 350px tall, no MaxHeight games.
                         The ListBox fills that rectangle and its built-in
                         ScrollViewer (forced visible via the attached
                         property) handles overflow. Predictable, hardened
                         pattern — same shape as VS Code's bottom panel,
                         the Explorer's per-folder children, etc. -->
                    <TextBlock Text="{Binding ResourcesHeader}"
                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <Border Background="#1B1B22" CornerRadius="6"
                            Height="350">
                        <ListBox ItemsSource="{Binding Resources}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:SkillResource">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding RelativePath}"
                                                   FontFamily="Cascadia Code,Consolas,monospace"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeBytes, StringFormat='{}{0:N0} B'}"
                                                   FontSize="10" Opacity="0.5"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- ─── Validation findings (per-skill) ───
                         Grows naturally; the outer page ScrollViewer
                         handles overflow. Typical skills have <5 findings,
                         so this rarely needs to be bounded. -->
                    <TextBlock Text="Validation" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:Finding">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,3" ColumnSpacing="10">
                                    <Border Grid.Column="0" CornerRadius="4" Padding="7,3"
                                            VerticalAlignment="Top"
                                            Background="{Binding Severity,
                                                Converter={StaticResource SeverityBrush}}">
                                        <TextBlock Text="{Binding Severity}" FontSize="10"
                                                   Foreground="#1A1A1A"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                   Opacity="0.45"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bottom breathing room: a fixed-height empty Border
                         so scrolling to the bottom of the page leaves a
                         clear gap between the last finding and the window
                         edge. -->
                    <Border Height="48"/>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
