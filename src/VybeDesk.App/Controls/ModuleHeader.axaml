<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VybeDesk.App.ViewModels"
             xmlns:m="using:VybeDesk.Core.Models"
             x:Class="VybeDesk.App.Controls.ModuleHeader"
             x:DataType="vm:PageViewModel"
             Name="Root">
    <!--
      Unified module header (v0.31 redesign — single-band 105px). Replaces
      the previous 78px ModuleHeader + 74px ModuleSubHeader stack with ONE
      richer control that packs everything into:

        Row 0 (main, *):     left column (text/title/breadcrumbs/description),
                             middle column (project picker, RowSpan=2),
                             right column (Reset/Restart chips, RowSpan=2)
        Row 1 (status, 25):  slightly-lighter background sub-region with
                             StatusMessage text

      The control has TWO sources of data:

        1) DataContext-bound surfaces (inherited from the parent view's
           PageViewModel): Title / Glyph / Description / Breadcrumbs /
           GoModuleHomeCommand / ResetCommand / RestartCommand. Compiled
           bindings resolve these polymorphically against PageViewModel.

        2) StyledProperty surfaces (set explicitly per call site):
           ShowPicker / ProjectsSource / PickerSelectedItem / StatusMessage.
           Bound via {Binding #Root.X} ElementName syntax — the only thing
           that compiles for cross-typed StyledProperties on the derived
           UserControl ($parent[UserControl] resolves to the base
           UserControl type and fails AVLN2000).

      LAYOUT INVARIANT (LOCKED 2026-05-24): the outer Border Height is fixed
      at 105px. Do NOT parametrise; do NOT let it grow. Every sidebar page
      renders a 105px-tall header band regardless of which fields are
      populated. Description is single-line + ellipsis; status is single-
      line + ellipsis. The picker MinWidth is 260 (column) / 220 (combo)
      so dropdown text stays readable. When ShowPicker=False the middle
      column collapses to 0 width and the left column gets the slack.

      Buttons (home / Reset / Restart) auto-hide when their command is
      null — a VM that doesn't override the corresponding virtual silently
      gets a title-only header.
    -->
    <Border Background="#1B1B22" Height="105">
        <Grid RowDefinitions="*,25">

            <!-- ===== Row 0: the main 3-column / 2-row layout ===== -->
            <Grid Grid.Row="0" Margin="20,12,20,12"
                  ColumnDefinitions="*,Auto,Auto"
                  RowDefinitions="Auto,Auto" RowSpacing="6">

                <!-- LEFT COLUMN, ROW 0: glyph + title-as-link + breadcrumbs.
                     The title IS the home link (v2 follow-up, 2026-05-24):
                     the old separate 🏠 button is gone and the title itself
                     fires GoModuleHomeCommand when one is bound. When the
                     command is null the button still renders as the title
                     text at full opacity (no Avalonia disabled dimming) so
                     the visual height stays uniform across modules. -->
                <StackPanel Grid.Column="0" Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Module glyph (sits to the LEFT of the title). -->
                    <TextBlock Text="{Binding Glyph}"
                               FontSize="18" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <!-- Module title — clickable home link when
                         GoModuleHomeCommand is non-null. Styled to look
                         identical to the previous static TextBlock at rest
                         (FontSize=20, SemiBold, white). Hover affordance +
                         hand cursor light up only when enabled; when
                         disabled the chrome stays at full opacity. -->
                    <Button Classes="header-title"
                            Content="{Binding Title}"
                            Command="{Binding GoModuleHomeCommand}"
                            IsEnabled="{Binding GoModuleHomeCommand,
                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Back to module home"/>

                    <!-- Breadcrumbs -->
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text=" &#x203A; " Opacity="0.4"/>
                                    <TextBlock Text="{Binding}" Opacity="0.75"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- LEFT COLUMN, ROW 1: description / explainer line.
                     ALWAYS rendered (even empty) so the row height is
                     allocated and the header height stays uniform.
                     MaxLines=1 + TextTrimming caps overflow. -->
                <TextBlock Grid.Column="0" Grid.Row="1"
                           Text="{Binding Description}"
                           Opacity="0.6" FontSize="12"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <!-- MIDDLE COLUMN: project picker. RowSpan=2 + vertically
                     centered. Only rendered when ShowPicker=True; when
                     hidden the column collapses to 0 width and the left
                     column gets the slack. MinWidth keeps it readable
                     without dominating the header. -->
                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                      ColumnDefinitions="Auto,Auto" ColumnSpacing="8"
                      VerticalAlignment="Center"
                      MinWidth="260" Margin="20,0"
                      IsVisible="{Binding #Root.ShowPicker}">
                    <TextBlock Grid.Column="0" Text="Project:" Opacity="0.6"
                               VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox Grid.Column="1" MinWidth="220"
                              ItemsSource="{Binding #Root.ProjectsSource}"
                              SelectedItem="{Binding #Root.PickerSelectedItem,
                                                     Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="m:Project">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- RIGHT COLUMN: Reset + Restart chips. RowSpan=2 +
                     vertically centered. Each chip is ALWAYS visible
                     (v2 follow-up, 2026-05-24) but DISABLED when its
                     corresponding command on the VM is null — the
                     disabled-state Style below dulls the chip colours
                     so it reads as "available action, not applicable
                     here" rather than vanishing entirely. This keeps
                     the right edge of the header chrome consistent
                     across every module. -->
                <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                            Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Button Classes="chip-reset"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding ResetCommand,
                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Clear the input fields on this page">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="&#x21BA;"/>
                            <TextBlock Text="Reset"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="chip-restart"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding RestartCommand,
                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Start the module over (clears everything)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="&#x21BB;"/>
                            <TextBlock Text="Restart"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Row 1: status bar — slightly-lighter background ===== -->
            <!-- One shade lighter than the header's #1B1B22 so the band reads
                 as a distinct sub-region. Always rendered (empty StatusMessage
                 = blank band, same height) to keep header chrome uniform.
                 Text is light-green (#7FD18B, same hue used by Settings's
                 inline status TextBlock) and prefixed/suffixed with
                 "status: …" per user request 2026-05-24. The StringFormat
                 only fires when StatusMessage is non-empty (IsVisible
                 toggle), so an empty status doesn't render a bare
                 "status: …" with nothing in the middle. -->
            <Border Grid.Row="1" Background="#22222A" Padding="20,0">
                <TextBlock Text="{Binding #Root.StatusMessage, StringFormat='status: {0}…'}"
                           Foreground="#7FD18B" Opacity="0.9" FontSize="11"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           IsVisible="{Binding #Root.StatusMessage,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Border>

        </Grid>
    </Border>

    <UserControl.Styles>
        <!--
          Chip / title-button specialisations layered ON TOP of the
          app-wide Button style in App.axaml (CornerRadius=6, Padding=12,5,
          FontSize=12). Scoped to this control via the Classes attribute so
          they don't leak to other views.

          chip-reset / chip-restart: red / blue accent chips. The :disabled
          variant dulls saturation so an "unavailable here" chip is still
          legible against the #1B1B22 header background but clearly inactive.

          header-title: the module title rendered AS a Button so it can fire
          GoModuleHomeCommand. Looks identical to the previous static
          TextBlock at rest (transparent background, no border, white
          SemiBold 20pt). When enabled (command non-null) the pointerover
          state nudges opacity down for a subtle hover affordance + the
          cursor becomes Hand. When disabled (command null) the disabled
          ContentPresenter override pins opacity back to 1 so the title
          never looks "greyed", and the cursor stays Arrow.
        -->
        <Style Selector="Button.chip-reset">
            <Setter Property="Background" Value="#3A2126"/>
            <Setter Property="Foreground" Value="#E06C6C"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.chip-reset:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2128"/>
            <Setter Property="Foreground" Value="#5A3D43"/>
        </Style>
        <Style Selector="Button.chip-restart">
            <Setter Property="Background" Value="#1F2A3A"/>
            <Setter Property="Foreground" Value="#5E8FE0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.chip-restart:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F2630"/>
            <Setter Property="Foreground" Value="#3E5872"/>
        </Style>

        <!-- Title-as-link: looks like the static TextBlock it replaced. -->
        <Style Selector="Button.header-title">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <!-- Hand cursor only when the home command is bound. -->
        <Style Selector="Button.header-title:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Hover affordance: subtle opacity dip — applies only when the
             button is enabled (Avalonia only matches :pointerover on an
             enabled control). -->
        <Style Selector="Button.header-title:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <!-- When the title is disabled (no home command), explicitly pin
             opacity back to 1 so the title text doesn't look greyed by the
             Fluent disabled style. -->
        <Style Selector="Button.header-title:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>
</UserControl>
