<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VybeDesk.App.ViewModels"
             xmlns:m="using:VybeDesk.Core.Models"
             xmlns:ctl="using:VybeDesk.App.Controls"
             x:Class="VybeDesk.App.Views.DocumentationView"
             x:DataType="vm:DocumentationViewModel">

    <!--
      Restructured 2026-05-24 to mirror SkillManagerView: docked-left rail
      (Width=320, #22222A) holding the folder controls + Documents list,
      with a right pane that has a chips + actions toolbar above the
      workspace.

      Layout (locked):
        DockPanel
          - ctl:ModuleHeader DockPanel.Dock="Top"   :: spans full width
          - Border DockPanel.Dock="Left" Width=320  :: folder + docs rail
          - Grid (fill)                             :: chips/actions + workspace

      The unified header is the FIRST DockPanel.Dock="Top" child so it
      reserves the full top strip BEFORE the left rail docks underneath it
      (LOCKED layout invariant from plans/20260524-unified-module-header.md).

      The status TextBlock that used to live in the controls row is gone —
      the unified header's bottom band carries StatusMessage now.

      The workspace (Grid.Row=1 of the right pane) preserves the three
      pre-existing mutually-exclusive states verbatim: findings + AI semantic
      + fix prompt (default), audit overlay, inline editor. Only the OUTER
      container moved — the inner markup of each state is untouched.
    -->
    <DockPanel LastChildFill="True">

        <!-- ===== UNIFIED HEADER (105px) — first Top-docked child ===== -->
        <ctl:ModuleHeader DockPanel.Dock="Top"
                          ShowPicker="True"
                          ProjectsSource="{Binding Projects}"
                          PickerSelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          StatusMessage="{Binding StatusMessage}"/>

        <!-- ===== LEFT RAIL: folder controls + Documents list ===== -->
        <Border DockPanel.Dock="Left" Width="300"
                Background="{DynamicResource StratumSurface0}" CornerRadius="12"
                Margin="12,12,6,12" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="10">

                    <!--
                      Folder path + icon-only Browse + icon-only Scan.
                      Modelled on SkillManagerView lines 48-65: TextBox
                      stretches; both icon buttons sit on the right with
                      tooltips for affordance. Scan is disabled while a
                      scan is already in flight.
                    -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding FolderPath}"
                                 Watermark="Folder path to scan…"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Padding="8,4"
                                Command="{Binding BrowseFolderCommand}"
                                ToolTip.Tip="Browse for a folder">
                            <TextBlock Text="&#x1F4C1;" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="2"
                                Padding="8,4"
                                Command="{Binding ScanCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                ToolTip.Tip="Scan the folder for docs">
                            <TextBlock Text="&#x1F504;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!--
                      Watch-mode toggle. Placed in the rail under the folder
                      row (judgement call): watch-mode is a folder-level
                      concern about how the rail's list is kept fresh, so it
                      belongs in the rail rather than the action toolbar
                      that operates on the scan result.
                    -->
                    <CheckBox Content="Watch mode"
                              IsChecked="{Binding IsWatchModeEnabled}"
                              ToolTip.Tip="Rescan automatically when .md / .txt files under the project folder change (debounced)."/>

                    <TextBlock Text="Documents" FontWeight="SemiBold"
                               Margin="2,4,0,0"/>
                </StackPanel>

                <!--
                  Documents list — the existing item template (RelativePath
                  + Name subtext) is preserved verbatim. DockPanel-fill so
                  it expands to take whatever vertical space the rail has.
                -->
                <ListBox ItemsSource="{Binding Docs}"
                         SelectedItem="{Binding SelectedDoc}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:DocFile">
                            <Grid ColumnDefinitions="Auto,*" Margin="2,3" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="📄" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding RelativePath}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                               Opacity="0.4"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== RIGHT PANE: chips/actions toolbar + workspace ===== -->
        <Border Background="{DynamicResource StratumBorder1}" CornerRadius="12" Margin="12">
        <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="12">

            <!-- ===== Row 0: action toolbar — chips + separator + actions ===== -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        Spacing="8" VerticalAlignment="Center"
                        IsVisible="{Binding HasProject}">

                <!-- Action buttons -->
                <Button Content="Run AI Analysis"
                        Command="{Binding RunSemanticCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                <Button Content="Cancel"
                        Command="{Binding RunSemanticCancelCommand}"
                        IsVisible="{Binding IsBusy}"/>
                <Button Content="Audit Project"
                        Command="{Binding RunAuditCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        ToolTip.Tip="Synthesize an audit across all docs: project design + roadmap items (complete / incomplete) + inconsistencies."/>
                <Button Content="Cancel"
                        Command="{Binding RunAuditCancelCommand}"
                        IsVisible="{Binding IsBusy}"/>
                <Button Content="Generate Fix Prompt"
                        Command="{Binding GenerateFixPromptCommand}"
                        IsEnabled="{Binding IsNotBusy}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="8" MinWidth="200">
                                <TextBlock Text="Fix Prompt Actions" FontWeight="SemiBold" FontSize="13"/>
                                <Button Content="Apply with AI"
                                        Command="{Binding ApplyReconciliationFixPromptWithAiCommand}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip.Tip="Open this fix prompt in the Notebook — review and click Send to apply."/>
                                <Button Content="Copy"
                                        Command="{Binding CopyCommand}"
                                        CommandParameter="{Binding FixPrompt}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Export Report"
                        Command="{Binding ExportReportCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
            </StackPanel>

            <!-- ===== Row 1: workspace ===== -->
            <!--
              Three mutually-exclusive states (findings/AI/fix-prompt,
              audit overlay, inline editor) preserved verbatim from the
              pre-restructure markup. The IsVisible bindings on each state
              already enforce mutual exclusion; the outer Grid simply
              overlays them. Inner structure of each state IS UNCHANGED.
            -->
            <Grid Grid.Row="1" IsVisible="{Binding HasProject}">

                <!-- Findings + panels (hidden while editor / audit is open) -->
                <Grid IsVisible="{Binding IsDefaultViewVisible}"
                      RowDefinitions="*,Auto,Auto" RowSpacing="12">

                <Border Grid.Row="0" Background="{DynamicResource StratumSurface1}" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="2,0,0,8">
                            <TextBlock Grid.Column="0" Text="Reconciliation findings"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                        IsVisible="{Binding HasReport}">
                                <Border Background="{DynamicResource StratumDanger}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Foreground="{DynamicResource StratumBg}" FontSize="10"
                                               Text="{Binding CriticalCount, StringFormat='Critical {0}'}"/>
                                </Border>
                                <Border Background="{DynamicResource StratumWarn}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Foreground="{DynamicResource StratumBg}" FontSize="10"
                                               Text="{Binding WarningCount, StringFormat='Warning {0}'}"/>
                                </Border>
                                <Border Background="{DynamicResource StratumInfo}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Foreground="{DynamicResource StratumBg}" FontSize="10"
                                               Text="{Binding InfoCount, StringFormat='Info {0}'}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <ListBox ItemsSource="{Binding Findings}" Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Finding">
                                    <Grid ColumnDefinitions="Auto,*" Margin="2,4" ColumnSpacing="10">
                                        <Border Grid.Column="0" CornerRadius="4" Padding="7,3"
                                                VerticalAlignment="Top"
                                                Background="{Binding Severity,
                                                    Converter={StaticResource SeverityBrush}}">
                                            <TextBlock Text="{Binding Severity}" FontSize="10"
                                                       Foreground="{DynamicResource StratumBg}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Category}" FontSize="10"
                                                           Opacity="0.45"/>
                                                <TextBlock Text="{Binding File}" FontSize="10"
                                                           Opacity="0.45"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- AI semantic result -->
                <Border Grid.Row="1" Background="{DynamicResource StratumSurface2}" CornerRadius="8" Padding="14"
                        MaxHeight="220" IsVisible="{Binding HasSemanticResult}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0" Text="AI semantic analysis"
                                       FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="Copy"
                                    Command="{Binding CopyCommand}"
                                    CommandParameter="{Binding SemanticResult}"
                                    Padding="8,2" FontSize="11"/>
                        </Grid>
                        <ScrollViewer Padding="0,0,50,0">
                            <SelectableTextBlock Text="{Binding SemanticResult}"
                                                 TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Fix prompt panel removed — actions accessible via Generate Fix Prompt flyout in toolbar -->

                </Grid>

                <!-- Project Audit overlay (M2.5) — synthesis pass output.
                     Replaces findings + editor when open. -->
                <DockPanel IsVisible="{Binding IsAuditOpen}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="Project Audit" FontWeight="SemiBold"
                                   FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer Padding="0,0,50,0">
                        <StackPanel Spacing="14" Width="750" HorizontalAlignment="Left">

                            <!-- A) Project Design -->
                            <Border Background="{DynamicResource StratumSurface1}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="A) Project Design"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <ctl:MarkdownPresenter Markdown="{Binding AuditDesign}"/>
                                </StackPanel>
                            </Border>

                            <!-- B) Roadmap items (all) -->
                            <Border Background="{DynamicResource StratumSurface1}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="B) Roadmap — all items"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <ItemsControl ItemsSource="{Binding AuditItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditRoadmapItem">
                                                <Grid ColumnDefinitions="90,400,200"
                                                      Margin="0,4" ColumnSpacing="10">
                                                    <Border Grid.Column="0" CornerRadius="3"
                                                            Padding="6,2" VerticalAlignment="Top"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding Status,
                                                                Converter={StaticResource AuditStatusBrush}}">
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{DynamicResource StratumBg}" FontSize="10"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Evidence}"
                                                                   Opacity="0.6" FontSize="11"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="1">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10" Opacity="0.55"/>
                                                        <TextBlock Text="{Binding Source}"
                                                                   FontSize="10" Opacity="0.45"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- C) Completed -->
                            <Border Background="{DynamicResource StratumSurface1}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" FontSize="14">
                                        <Run Text="C) Completed ("/>
                                        <Run Text="{Binding AuditComplete.Count}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding AuditComplete}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditRoadmapItem">
                                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                                    <Run Text="✓ " Foreground="{DynamicResource StratumSuccess}"/>
                                                    <Run Text="{Binding Title}"/>
                                                    <Run Text=" — " Foreground="{DynamicResource StratumText3}"/>
                                                    <Run Text="{Binding Evidence}" Foreground="{DynamicResource StratumText2}" FontSize="11"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- D) Incomplete -->
                            <Border Background="{DynamicResource StratumSurface1}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" FontSize="14">
                                        <Run Text="D) Incomplete / Unknown ("/>
                                        <Run Text="{Binding AuditIncomplete.Count}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding AuditIncomplete}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditRoadmapItem">
                                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                                    <Run Text="▢ " Foreground="{DynamicResource StratumWarn}"/>
                                                    <Run Text="{Binding Title}"/>
                                                    <Run Text=" — " Foreground="{DynamicResource StratumText3}"/>
                                                    <Run Text="{Binding Source}" Foreground="{DynamicResource StratumText2}" FontSize="11"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Audit fix prompt — appears after Generate Fix
                                 Prompt is clicked. -->
                            <Border Background="{DynamicResource StratumSurface2}" CornerRadius="8" Padding="14"
                                    IsVisible="{Binding IsAuditFixPromptVisible}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Claude Code fix prompt"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="Apply with AI"
                                                    Command="{Binding ApplyAuditFixPromptWithAiCommand}"
                                                    Padding="8,2" FontSize="11"
                                                    ToolTip.Tip="Open this audit prompt in the Notebook — review and click Send to apply."/>
                                            <Button Content="Copy"
                                                    Command="{Binding CopyCommand}"
                                                    CommandParameter="{Binding AuditFixPrompt}"
                                                    Padding="8,2" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding AuditFixPrompt}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="320"
                                             FontFamily="Cascadia Code,Consolas,monospace"
                                             FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Inconsistencies -->
                            <Border Background="{DynamicResource StratumSurface2}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" FontSize="14">
                                        <Run Text="Inconsistencies ("/>
                                        <Run Text="{Binding AuditInconsistencies.Count}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <TextBlock Text="No disagreements found across the docs."
                                               Opacity="0.55"
                                               IsVisible="{Binding !HasInconsistencies}"/>
                                    <ItemsControl ItemsSource="{Binding AuditInconsistencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AuditInconsistency">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      Margin="0,4" ColumnSpacing="10">
                                                    <Border Grid.Column="0" CornerRadius="3"
                                                            Padding="6,2" VerticalAlignment="Top"
                                                            Background="{Binding Severity,
                                                                Converter={StaticResource SeverityBrush}}">
                                                        <TextBlock Text="{Binding Severity}"
                                                                   Foreground="{DynamicResource StratumBg}" FontSize="10"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Issue}"
                                                                   TextWrapping="Wrap"/>
                                                        <ItemsControl ItemsSource="{Binding Docs}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Background="{DynamicResource StratumBorder2}"
                                                                            CornerRadius="3"
                                                                            Padding="5,1" Margin="0,0,4,0">
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="10"
                                                                                   FontFamily="Cascadia Code,Consolas,monospace"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Inline doc editor (M2.6) — replaces findings when a doc
                     is selected. Header docks top, body fills, buttons row
                     pinned visually via the header. -->
                <DockPanel IsVisible="{Binding IsEditorOpen}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Spacing="8" Margin="0,0,0,10">
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380"/>
                        <Button Content="Save"
                                Command="{Binding SaveEditorCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Revert"
                                Command="{Binding RevertEditorCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Close"
                                Command="{Binding CloseEditorCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding EditorContent}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             AcceptsTab="True"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="13"
                             VerticalContentAlignment="Top">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveEditorCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                </DockPanel>

            </Grid>

            <!-- No-project placeholder — LAST child = highest z-order so it
                 renders ON TOP of the toolbar and workspace beneath. Solid
                 background occludes content until a project is picked. -->
            <Border Grid.RowSpan="2"
                    IsVisible="{Binding !HasProject, FallbackValue=True}"
                    Background="{DynamicResource StratumBorder1}">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please choose a project"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource StratumInfo}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a project from the picker above to scan its documentation."
                               FontSize="13" Opacity="0.6"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="360" TextAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
        </Border>
    </DockPanel>
</UserControl>
