<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VybeDesk.App.ViewModels"
             xmlns:m="using:VybeDesk.Core.Models"
             xmlns:ctl="using:VybeDesk.App.Controls"
             x:Class="VybeDesk.App.Views.NotebookView"
             x:DataType="vm:NotebookViewModel">

    <!-- v0.31 unified header (105px). Notebook is project-scoped so
         ShowPicker=True; binding name exception is ActiveProject (not
         SelectedProject). Picker has been removed from the right-side
         panel and lives in the header now; the old "AI Notebook" title
         + status row at the top of the chat column is also gone (title
         from header, status from header's bottom band). -->
    <DockPanel LastChildFill="True">

        <ctl:ModuleHeader DockPanel.Dock="Top"
                          ShowPicker="True"
                          ProjectsSource="{Binding Projects}"
                          PickerSelectedItem="{Binding ActiveProject, Mode=TwoWay}"
                          StatusMessage="{Binding StatusMessage}"/>

        <Grid ColumnDefinitions="*,366">

            <!-- Chat -->
            <DockPanel Grid.Column="0" Margin="24,20,12,20"
                       IsVisible="{Binding HasProject}">

                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8" Margin="0,10,0,0">
                    <TextBox Grid.Column="0" Text="{Binding ChatInput}"
                             Watermark="Ask for advice, or ask to create / move files… (Ctrl+Enter to send)"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Send" VerticalAlignment="Stretch"
                            Command="{Binding SendCommand}" IsEnabled="{Binding IsNotBusy}"/>
                    <Button Grid.Column="2" Content="Cancel" VerticalAlignment="Stretch"
                            Command="{Binding SendCancelCommand}"
                            IsVisible="{Binding IsBusy}"/>
                </Grid>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NotebookMessage">
                                <Border Background="{DynamicResource VdSurface2}" CornerRadius="8" Padding="12"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Role}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" Opacity="0.55"/>
                                            <Button Grid.Column="1" Content="Copy"
                                                    IsVisible="{Binding HasText}"
                                                    Padding="6,1" FontSize="10"
                                                    Command="{Binding $parent[ItemsControl].((vm:NotebookViewModel)DataContext).CopyMessageCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>

                                        <!-- Tool actions ABOVE the prose: italic chips,
                                             green for success, red for blocked / failure. -->
                                        <ItemsControl ItemsSource="{Binding Activities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ToolActivity">
                                                    <TextBlock Text="{Binding Description}"
                                                               FontStyle="Italic"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding Success,
                                                                   Converter={StaticResource ToolActivityBrush}}"
                                                               Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- "Thinking…" skeleton — shown for an
                                             assistant bubble until the first
                                             text delta lands. -->
                                        <TextBlock Text="thinking…"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource VdTextTertiary}"
                                                   IsVisible="{Binding ShowThinkingPlaceholder}"/>

                                        <!-- Markdown prose via our custom
                                             Markdig-backed presenter (M2.8).
                                             Headings, fenced code blocks,
                                             tables, inline code, bold/italic,
                                             lists, blockquotes. -->
                                        <ctl:MarkdownPresenter Markdown="{Binding Text}"
                                                               IsVisible="{Binding HasText}"/>

                                        <!-- Live streaming token meter -->
                                        <TextBlock Text="{Binding StreamingUsageSummary}"
                                                   IsVisible="{Binding HasStreamingUsage}"
                                                   FontSize="10" Opacity="0.55"
                                                   Foreground="{DynamicResource VdAccentText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>

                                        <!-- Per-bubble token usage badge (settled) -->
                                        <TextBlock Text="{Binding UsageSummary}"
                                                   IsVisible="{Binding HasUsage}"
                                                   FontSize="10" Opacity="0.45"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Side panel — the "Active project" picker section has moved
                 OUT of here INTO the unified header (v0.31). The scoped-roots
                 hint stays here since it's contextual to the chat panel. -->
            <Border Grid.Column="1" Background="{DynamicResource VdSurface2}"
                    IsVisible="{Binding HasProject}">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="18">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Active project scope" FontWeight="SemiBold"/>
                            <TextBlock Text="File actions are confined to this project's folder. Pick the project in the header above."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding ScopeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScopeProjectRow">
                                        <StackPanel Spacing="2" Margin="0,3">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ProjectName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource VdAccentText}"/>
                                                <TextBlock Text="show file path"
                                                           IsVisible="{Binding !IsPathVisible}"
                                                           FontSize="11" Foreground="{DynamicResource VdAccentText}"
                                                           Cursor="Hand"
                                                           PointerPressed="OnTogglePathClick"/>
                                                <TextBlock Text="hide file path"
                                                           IsVisible="{Binding IsPathVisible}"
                                                           FontSize="11" Foreground="{DynamicResource VdAccentText}"
                                                           Cursor="Hand"
                                                           PointerPressed="OnTogglePathClick"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FolderPath}"
                                                       IsVisible="{Binding IsPathVisible}"
                                                       FontSize="11" Foreground="{DynamicResource VdAccentText}"
                                                       TextDecorations="Underline"
                                                       Cursor="Hand"
                                                       PointerPressed="OnOpenExplorerClick"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Proposed actions" FontWeight="SemiBold"/>
                            <TextBlock Text="Claude's file actions appear here for review before they run."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding PendingActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AgentActionRow">
                                        <Border Background="{DynamicResource VdSurface2}" CornerRadius="6"
                                                Padding="10" Margin="0,3">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Description}"
                                                           TextWrapping="Wrap" FontSize="12"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11"
                                                           Opacity="0.6" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding HasPendingActions}">
                                <Button Content="Execute All" Command="{Binding ExecuteActionsCommand}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                                <Button Content="Cancel"
                                        Command="{Binding ExecuteActionsCancelCommand}"
                                        IsVisible="{Binding IsBusy}"/>
                                <Button Content="Clear" Command="{Binding ClearActionsCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Action history" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding ActionHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="11" Opacity="0.6"
                                                   TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Undo Last" Command="{Binding UndoLastCommand}"
                                        IsEnabled="{Binding CanUndo}"/>
                                <Button Content="Redo Last" Command="{Binding RedoLastCommand}"
                                        IsEnabled="{Binding CanRedo}"
                                        ToolTip.Tip="Re-apply the most recently undone action."/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Notes" FontWeight="SemiBold"/>
                            <Button Content="Save last response as note"
                                    Command="{Binding SaveLastResponseCommand}"/>
                            <ListBox ItemsSource="{Binding Notes}"
                                     SelectedItem="{Binding SelectedNote}"
                                     Background="Transparent" BorderThickness="0" MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:Note">
                                        <TextBlock Text="{Binding Title}" Margin="2,3"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Selected-note actions + body preview -->
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding SelectedNote,
                                            Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Insert into chat"
                                            Command="{Binding InsertNoteIntoChatCommand}"
                                            Padding="8,2" FontSize="11"
                                            ToolTip.Tip="Prepend this note's text to the chat input as reference for your next message."/>
                                    <Button Content="Copy"
                                            Command="{Binding CopySelectedNoteCommand}"
                                            Padding="8,2" FontSize="11"/>
                                    <Button Content="Delete"
                                            Command="{Binding DeleteNoteCommand}"
                                            Padding="8,2" FontSize="11"/>
                                </StackPanel>
                                <Border Background="{DynamicResource VdSurface1}" CornerRadius="6" Padding="10" MaxHeight="200">
                                    <ScrollViewer Padding="0">
                                        <SelectableTextBlock Text="{Binding SelectedNote.Body, FallbackValue=''}"
                                                             FontSize="11"
                                                             TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== LANDING: "Choose a project" with project cards =====
                 LAST child = highest z-order so it renders ON TOP of chat
                 and notes panels. Solid background fully occludes. -->
            <Border Grid.ColumnSpan="2"
                    IsVisible="{Binding !HasProject, FallbackValue=True}"
                    Background="{DynamicResource VdSurface1}">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="16" Margin="28"
                            MaxWidth="520">
                    <TextBlock Text="&#x1F4D3;" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose a project"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource VdAccentText}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a project to scope the Notebook's file actions, or choose 'All Projects' to work across every registered project."
                               FontSize="13" Opacity="0.6"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <!-- All Projects button — prominent, always first -->
                    <Button HorizontalAlignment="Stretch"
                            Padding="14,10"
                            Command="{Binding PickProjectFromLandingCommand}"
                            CommandParameter="{Binding Projects[0]}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#x1F30D;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="All Projects" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Work across every registered project folder."
                                           FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="— or select a project —"
                               FontSize="12" Opacity="0.4"
                               HorizontalAlignment="Center"
                               Margin="0,4"/>

                    <!-- Paginated project cards (4 per page, no scrolling) -->
                    <ItemsControl ItemsSource="{Binding PagedLandingProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:Project">
                                <Button Margin="0,2"
                                        Padding="14,10"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[ItemsControl].((vm:NotebookViewModel)DataContext).PickProjectFromLandingCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="&#x1F4C1;" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding FolderPath}" FontSize="11" Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pagination controls — only visible when >1 page -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          IsVisible="{Binding LandingHasMultiplePages}"
                          Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Content="&#x2190;  Prev"
                                Command="{Binding LandingPrevPageCommand}"
                                IsEnabled="{Binding CanLandingPrev}"
                                Padding="14,6"
                                FontSize="12"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LandingPageLabel}"
                                   FontSize="12" Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="Next  &#x2192;"
                                Command="{Binding LandingNextPageCommand}"
                                IsEnabled="{Binding CanLandingNext}"
                                Padding="14,6"
                                FontSize="12"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
