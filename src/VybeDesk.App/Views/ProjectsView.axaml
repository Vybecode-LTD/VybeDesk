<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VybeDesk.App.ViewModels"
             xmlns:m="using:VybeDesk.Core.Models"
             xmlns:ctl="using:VybeDesk.App.Controls"
             x:Class="VybeDesk.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

    <DockPanel LastChildFill="True">

        <ctl:ModuleHeader DockPanel.Dock="Top"
                          StatusMessage="{Binding StatusMessage}"/>

        <!-- Left rail — project list -->
        <Border DockPanel.Dock="Left" Width="300"
                Background="{DynamicResource StratumSurface0}" CornerRadius="12"
                Margin="12,12,6,12" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
                    <Button Content="New project"
                            Command="{Binding NewProjectCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="Import existing&#x2026;"
                            Command="{Binding ImportExistingCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            ToolTip.Tip="Pick a folder to ingest its CLAUDE.md, git LastActivity, and .claude/commands/*.md prompts."/>
                </StackPanel>
                <ListBox Margin="0,8,0,0"
                         ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Project">
                            <Grid ColumnDefinitions="Auto,*" Margin="2,3" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="📁" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FolderPath}" FontSize="9"
                                               Opacity="0.45"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right pane — scrollable form in a rounded container.
             ScrollViewer is the fill child of the outer DockPanel; the
             StackPanel inside grows unbounded and the ScrollViewer clips
             to the bounded height it receives from MainWindow's
             VerticalContentAlignment="Stretch" chain. -->
        <Border Background="{DynamicResource StratumBorder1}" CornerRadius="12" Margin="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,12,20,12" MaxWidth="600" Spacing="0">

            <TextBlock Text="Select a project on the left or create a new one."
                       Opacity="0.5"
                       IsVisible="{Binding !HasSelection}"/>

            <StackPanel Spacing="7" IsVisible="{Binding HasSelection}">
                <TextBlock Text="Edit project" FontWeight="Bold" FontSize="13"/>

                <StackPanel Spacing="2">
                    <TextBlock Text="Name" Opacity="0.6" FontSize="10"/>
                    <TextBox Text="{Binding EditName}"/>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Description" Opacity="0.6" FontSize="10"/>
                    <TextBox Text="{Binding EditDescription}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="46" MaxHeight="80"
                             VerticalContentAlignment="Top"/>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Folder path" Opacity="0.6" FontSize="10"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding EditFolderPath}"
                                 Watermark="C:\dev\my-project"/>
                        <Button Grid.Column="1" Content="Browse&#x2026;"
                                Command="{Binding BrowseFolderCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Status" Opacity="0.6" FontSize="10"/>
                    <ComboBox ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding EditStatus}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Logo path (optional)" Opacity="0.6" FontSize="10"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding EditLogoPath}"
                                 Watermark="logo.png (blank = project glyph)"/>
                        <Button Grid.Column="1" Content="Browse&#x2026;"
                                Command="{Binding BrowseLogoPathCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Model override" Opacity="0.6" FontSize="10"/>
                    <ComboBox ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModelOption}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelOption">
                                <StackPanel Spacing="0" Margin="0,1">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding Tier}" FontSize="9" Opacity="0.6"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding EditModel}"
                             Watermark="or paste a custom model ID (blank = global default)"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="10"/>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Default output path" Opacity="0.6" FontSize="10"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding EditDefaultOutputPath}"
                                 Watermark="C:\…\output (blank = global default)"/>
                        <Button Grid.Column="1" Content="Browse&#x2026;"
                                Command="{Binding BrowseDefaultOutputPathCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="Open in Claude Code"
                            Command="{Binding OpenInClaudeCodeCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
        </Border>

    </DockPanel>
</UserControl>
