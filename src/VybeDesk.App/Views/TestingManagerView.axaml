<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VybeDesk.App.ViewModels"
             xmlns:m="using:VybeDesk.Core.Models"
             xmlns:ctl="using:VybeDesk.App.Controls"
             x:Class="VybeDesk.App.Views.TestingManagerView"
             x:DataType="vm:TestingManagerViewModel">

    <!--
        Pattern C — data-driven stepped wizard.
        ========================================
        The questionnaire is rendered ONE QUESTION AT A TIME via a
        ContentControl bound to CurrentQuestion. The other questions are
        not in the visual tree at all, so the right pane never overflows
        the viewport — no ScrollViewer is needed for the wizard itself.
        This sidesteps the Avalonia ScrollViewer-in-Grid-column height
        bug that surfaced in v0.27's first iteration. The plan view
        (after the user saves a strategy) keeps its ScrollViewer because
        its content is short and self-contained.

        Alternative patterns (A and B) are documented in
        docs/design-patterns/testing-manager-wizard-options.md — if
        Pattern C fails or proves over-engineered, the doc is the
        starting point.

        Outer container is a DockPanel: docked-left Border for the
        project picker, then a Grid that fills the rest with three
        mutually-exclusive top-level states (questionnaire / review /
        plan). DockPanel ensures the fill-child gets a bounded height,
        which we'd want even if we re-introduced a ScrollViewer later.
    -->
    <DockPanel LastChildFill="True">

        <!-- ============ UNIFIED HEADER (v0.31 redesign) ============
             LAYOUT INVARIANT (locked): the unified header is the FIRST
             DockPanel.Dock="Top" child, so it spans the full content
             width ABOVE the docked-left rail. DockPanel processes
             children in declaration order — placing the header first
             with Dock="Top" reserves the entire top strip, then the
             left rail docks underneath in the remaining region. The
             old "Testing Manager" title TextBlock that used to live in
             the rail has moved out into the header. Single 105px band
             carries title, breadcrumbs, project picker, chips, and the
             status row. -->
        <ctl:ModuleHeader DockPanel.Dock="Top"
                          ShowPicker="True"
                          ProjectsSource="{Binding Projects}"
                          PickerSelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          StatusMessage="{Binding StatusMessage}"/>

        <!-- LEFT: explainer + plan-state status (project picker has moved up
             into the canonical picker band above per the locked uniformity
             invariant; the rail keeps the wizard explainer + the HasPlan /
             !HasPlan status messages, which describe THIS module's workflow
             rather than the picker). KEPT for this patch; Phase 4 is the
             natural moment to re-evaluate whether the rail is still needed
             at all on this view. -->
        <Border DockPanel.Dock="Left" Width="300"
                Background="#1E1F2B" CornerRadius="12" Margin="12,12,6,12" Padding="14">
            <StackPanel Spacing="12">
                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                           Text="Pick a strategy by answering a handful of plain-language questions. Save the strategy per project, then generate Claude Code setup and regression-test prompts."/>

                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding HasPlan}"
                           Text="Strategy saved. Re-run the questionnaire from the plan view if the project's needs change."/>

                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding !HasPlan}"
                           Text="No strategy yet. Step through the five questions on the right."/>
            </StackPanel>
        </Border>

        <!-- RIGHT: one of three states (none of them need scrolling) -->
        <Border Background="#26262E" CornerRadius="12" Margin="12">
        <Grid Margin="28">

            <!-- ============ STATE 1 — STEPPED QUESTIONNAIRE ============ -->
            <Grid IsVisible="{Binding IsQuestionnaireVisible}"
                  RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">

                <!-- Progress strip — one dot per step, blue if answered -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuestionViewModel">
                                <Ellipse Width="12" Height="12"
                                         Fill="{Binding IsAnswered,
                                            Converter={StaticResource BoolToBrush},
                                            ConverterParameter='#5E8FE0|#3A3A45'}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="1" Text="{Binding StepLabel}"
                               Opacity="0.6" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Status message -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                           Opacity="0.7" TextWrapping="Wrap"
                           Foreground="#9ABEE0"/>

                <!-- Current question — ContentControl swaps the DataTemplate
                     as CurrentStepIndex changes. Each step renders cleanly
                     with no fixed height; whatever's in the question fits
                     in the remaining vertical space. -->
                <ContentControl Grid.Row="2"
                                Content="{Binding CurrentQuestion}"
                                VerticalAlignment="Top">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:QuestionViewModel">
                            <StackPanel Spacing="14" MaxWidth="720"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="22" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuestionOption">
                                            <RadioButton GroupName="WizardOptions"
                                                         Content="{Binding Label}"
                                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         Margin="0,4"
                                                         Command="{Binding $parent[ItemsControl].((vm:QuestionViewModel)DataContext).PickCommand}"
                                                         CommandParameter="{Binding Token}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Back / Next / See-recommendation row -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Content="← Back"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding !IsFirstStep}"/>
                    <Button Grid.Column="2" Content="Cancel re-run"
                            Command="{Binding CancelReRunCommand}"
                            IsVisible="{Binding IsReRunning}"/>
                    <Button Grid.Column="3" Content="Next →"
                            Command="{Binding GoNextCommand}"
                            IsVisible="{Binding !IsLastStep}"
                            IsEnabled="{Binding CurrentQuestion.IsAnswered, FallbackValue=False}"/>
                    <Button Grid.Column="3" Content="See recommendation →"
                            Command="{Binding SeeRecommendationCommand}"
                            IsVisible="{Binding IsLastStep}"
                            IsEnabled="{Binding IsAnswersComplete}"/>
                </Grid>
            </Grid>

            <!-- ============ STATE 2 — RECOMMENDATION REVIEW ============ -->
            <Grid IsVisible="{Binding IsRecommendationReviewVisible}"
                  RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">

                <TextBlock Grid.Row="0" Text="Recommended strategy"
                           FontSize="22" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                           Opacity="0.7" TextWrapping="Wrap"
                           Foreground="#9ABEE0"/>

                <!-- Strategy prose. The summary itself is short prose —
                     fits in the available vertical space at 14px font. If
                     it ever balloons, this is the one place we'd add a
                     ScrollViewer back (with its parent already DockPanel-
                     constrained, so it'd work correctly). -->
                <Border Grid.Row="2" Background="#1B1B22"
                        CornerRadius="6" Padding="20"
                        VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding DraftRecommendation.Summary, FallbackValue=''}"
                                   TextWrapping="Wrap" FontSize="13"
                                   LineHeight="20" MaxWidth="780"
                                   HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="← Re-answer"
                            Command="{Binding ReAnswerCommand}"/>
                    <Button Content="Accept and save"
                            Command="{Binding AcceptRecommendationCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>
                </StackPanel>
            </Grid>

            <!-- ============ STATE 3 — SAVED PLAN VIEW ============ -->
            <ScrollViewer IsVisible="{Binding HasPlanViewVisible}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,50,0">
                <Grid MaxWidth="860" HorizontalAlignment="Stretch"
                      RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Saved strategy"
                                   FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                                   Text="Generate the framework setup prompts when you're ready to wire testing in, and the regression-test prompt whenever a bug is fixed."/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                               Opacity="0.7" TextWrapping="Wrap"
                               Foreground="#9ABEE0"/>

                    <Border Grid.Row="2" Background="#243340"
                            CornerRadius="6" Padding="14"
                            IsVisible="{Binding BugFixedNudge,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding BugFixedNudge}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Generate regression-test prompt"
                                        Command="{Binding GenerateRegressionPromptCommand}"/>
                                <Button Content="Dismiss"
                                        Command="{Binding DismissBugFixedNudgeCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="#1B1B22"
                            CornerRadius="6" Padding="16">
                        <TextBlock Text="{Binding CurrentPlan.StrategySummary, FallbackValue=''}"
                                   TextWrapping="Wrap" FontSize="13"
                                   LineHeight="20"/>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                        <Button Content="Generate setup prompt"
                                Command="{Binding GenerateSetupPromptCommand}"/>
                        <Button Content="Generate regression-test prompt"
                                Command="{Binding GenerateRegressionPromptCommand}"/>
                        <Button Content="Re-run questionnaire"
                                Command="{Binding StartReRunCommand}"/>
                    </StackPanel>

                    <Border Grid.Row="5" Background="#1B1B22"
                            CornerRadius="6" Padding="14"
                            IsVisible="{Binding SetupPromptOutput,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Framework setup prompt"
                                           FontWeight="SemiBold"/>
                                <Button Grid.Column="1" Content="Copy"
                                        Command="{Binding CopyCommand}"
                                        CommandParameter="{Binding SetupPromptOutput}"/>
                            </Grid>
                            <TextBlock Text="Paste into a fresh Claude Code session against this project."
                                       Opacity="0.5" FontSize="11"/>
                            <TextBox Text="{Binding SetupPromptOutput}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="240" MaxHeight="460"
                                     VerticalContentAlignment="Top"
                                     FontFamily="Cascadia Code,Consolas,monospace"
                                     FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="6" Background="#1B1B22"
                            CornerRadius="6" Padding="14"
                            IsVisible="{Binding RegressionPromptOutput,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Regression test prompt"
                                           FontWeight="SemiBold"/>
                                <Button Grid.Column="1" Content="Copy"
                                        Command="{Binding CopyCommand}"
                                        CommandParameter="{Binding RegressionPromptOutput}"/>
                            </Grid>
                            <TextBox Text="{Binding RegressionPromptOutput}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="180" MaxHeight="360"
                                     VerticalContentAlignment="Top"
                                     FontFamily="Cascadia Code,Consolas,monospace"
                                     FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Empty state: no project picked.
                 MUST be the LAST Grid child so it has highest z-order and
                 renders ON TOP of the content panels above. A solid
                 background ensures it fully occludes whatever is beneath. -->
            <Border IsVisible="{Binding !HasProject, FallbackValue=True}"
                    Background="#26262E">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please choose a project"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#9ABEE0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a project from the picker above to build a testing strategy."
                               FontSize="13" Opacity="0.6"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="360" TextAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
        </Border>
    </DockPanel>
</UserControl>
